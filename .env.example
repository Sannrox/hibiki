# Non-secret identifiers only. Authentication remains owned by gh, BirdClaw,
# and the existing Sekai/Chisei environment.
HIBIKI_NAMESPACE=hibiki
HIBIKI_TENKAI_REPOSITORY=owner/tenkai
HIBIKI_BIRDCLAW_ACCOUNT=account-name
HIBIKI_CHISEI_TARGET=unix:///absolute/path/to/sekai.sock

# Publication remains disabled unless the operator explicitly changes this.
# CI always forces this setting back to false.
HIBIKI_ALLOW_LIVE_WRITES=false
